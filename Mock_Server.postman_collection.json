		{
			"name": "Create New Student",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// check status code\r",
							"pm.test(\"Check status code is 201\", ()=>\r",
							"{\r",
							"    pm.response.to.have.status(201);\r",
							"})\r",
							"\r",
							"// check response time is less than 200ms\r",
							"pm.test(\"Check response time is less than 200ms\", () =>\r",
							"{\r",
							"    pm.expect(pm.response.responseTime).to.be.below(200);\r",
							"})\r",
							"\r",
							"//check cookies is present or not\r",
							"pm.test(\"Check if cookies are present\", () =>\r",
							"{\r",
							"    pm.expect(pm.cookies.count()).to.be.above(0);\r",
							"});\r",
							"\r",
							"//check content-type header is application/json\r",
							"pm.test(\"Check content-type header is application/json\", ()=>\r",
							"{\r",
							"    pm.expect(pm.response.headers.get(\"Content-Type\")).to.eql(\"application/json\");\r",
							"});\r",
							"\r",
							"// capture id from response\r",
							"var jsonData = pm.response.json();\r",
							"pm.collectionVariables.set(\"id\", jsonData.id);\r",
							"\r",
							"// validating json field in response\r",
							"pm.test(\" Validate value of response body\", ()=>\r",
							"{\r",
							"    const jsonData = pm.response.json();\r",
							"    //whole response\r",
							"    pm.expect(jsonData).to.be.an('object')\r",
							"    // individual fields\r",
							"    pm.expect(jsonData.id).to.be.a(\"string\");\r",
							"    pm.expect(jsonData.name).to.equal(pm.environment.get(\"name\"));\r",
							"    pm.expect(jsonData.location).to.equal(\"France\");\r",
							"    pm.expect(jsonData.phone).to.equal(String(pm.environment.get(\"phoneNumber\")));\r",
							"    // array validation\r",
							"    pm.expect(jsonData.courses).to.be.an('array');   \r",
							"    pm.expect(jsonData.courses).to.include.members([\"Playwright\", \"JavaScript\"]);\r",
							"})\r",
							"\r",
							"var jsonData = pm.response.json();\r",
							"// check array properties\r",
							"pm.test(\"Test array properties\", ()=>\r",
							"{\r",
							"    pm.expect(jsonData.courses).to.have.members([\"Playwright\", \"JavaScript\"])\r",
							"});\r",
							"\r",
							"// JSON Schema Validation using tv4 validator\r",
							"var schema = {\r",
							"  \"type\": \"object\",\r",
							"  \"properties\": {\r",
							"    \"id\": {\r",
							"      \"type\": \"string\"\r",
							"    },\r",
							"    \"name\": {\r",
							"      \"type\": \"string\"\r",
							"    },\r",
							"    \"location\": {\r",
							"      \"type\": \"string\"\r",
							"    },\r",
							"    \"phone\": {\r",
							"      \"type\": \"string\"\r",
							"    },\r",
							"    \"courses\": {\r",
							"      \"type\": \"array\",\r",
							"      \"items\": [\r",
							"        {\r",
							"          \"type\": \"string\"\r",
							"        },\r",
							"        {\r",
							"          \"type\": \"string\"\r",
							"        }\r",
							"      ]\r",
							"    }\r",
							"  },\r",
							"  \"required\": [\r",
							"    \"id\",\r",
							"    \"name\",\r",
							"    \"location\",\r",
							"    \"phone\",\r",
							"    \"courses\"\r",
							"  ]\r",
							"};\r",
							"\r",
							"pm.test(\"Validate JSON Schema using tv4 validator\", () =>\r",
							"{\r",
							"    pm.expect(tv4.validate(pm.response.json(), schema)).to.be.true;\r",
							"});\r",
							"\r",
							"\r",
							"// JSON schema validation using Ajv validator\r",
							"var Ajv = require('ajv');\r",
							"var ajv = new Ajv();\r",
							"\r",
							"var schema = {\r",
							"  \"type\": \"object\",\r",
							"  \"properties\": {\r",
							"    \"id\": {\r",
							"      \"type\": \"string\"\r",
							"    },\r",
							"    \"name\": {\r",
							"      \"type\": \"string\"\r",
							"    },\r",
							"    \"location\": {\r",
							"      \"type\": \"string\"\r",
							"    },\r",
							"    \"phone\": {\r",
							"      \"type\": \"string\"\r",
							"    },\r",
							"    \"courses\": {\r",
							"      \"type\": \"array\",\r",
							"      \"items\": [\r",
							"        {\r",
							"          \"type\": \"string\"\r",
							"        },\r",
							"        {\r",
							"          \"type\": \"string\"\r",
							"        }\r",
							"      ]\r",
							"    }\r",
							"  },\r",
							"  \"required\": [\r",
							"    \"id\",\r",
							"    \"name\",\r",
							"    \"location\",\r",
							"    \"phone\",\r",
							"    \"courses\"\r",
							"  ]\r",
							"};\r",
							"\r",
							"    const response = pm.response.json();\r",
							"    const validate= ajv.compile(schema);\r",
							"    const isValid = validate(response);\r",
							"\r",
							"pm.test(\"JSON schema validation using Ajv validator\", ()=>\r",
							"{\r",
							"    pm.expect(isValid).to.be.true;\r",
							"\r",
							"})\r",
							"\r",
							"if(!isValid)\r",
							"{\r",
							"    console.log(validate.errors);\r",
							"}\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
