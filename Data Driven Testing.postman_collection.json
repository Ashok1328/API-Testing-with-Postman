				{
					"name": "Submit new order",
					"item": [
						{
							"name": "Submit new order",
							"event": [
								{
									"listen": "test",
									"script": {
										"exec": [
											"// Test to check the status code \r",
											"\r",
											"pm.test(\"Check status code is 201\", ()=>\r",
											"{\r",
											"    pm.response.to.have.status(201);\r",
											"})\r",
											"\r",
											"// Test to capture the order_id from the response and store it in an environment variable\r",
											"\r",
											"var jsonData = JSON.parse(responseBody);\r",
											"pm.environment.set(\"order_id\",jsonData.orderId);\r",
											"\r",
											"// Test order id is same \r",
											"\r",
											"pm.test(\"Check order id is same\", ()=>\r",
											"{\r",
											"    pm.expect(pm.response.json().orderId).to.eql(pm.environment.get(\"order_id\"));\r",
											"});\r",
											"\r",
											"// Test order id is created is ture\r",
											"\r",
											"pm.test(\"Check order id is created is true\", () =>\r",
											"{\r",
											"    pm.expect(pm.response.json().created).to.eql(true);\r",
											"});"
										],
										"type": "text/javascript",
										"packages": {},
										"requests": {}
									}
								}
							],
							"request": {
