									"listen": "prerequest",
									"script": {
										"exec": [
											"var random = Math.random().toString().substring();\r",
											"\r",
											"var username = \"ashui\" + random;\r",
											"var useremail = \"ashui\" + random + \"@gmail.com\";\r",
											"\r",
											"pm.environment.set(\"username\", username);\r",
											"pm.environment.set(\"useremail\", useremail);"
										],
										"type": "text/javascript",
										"packages": {},
										"requests": {}
									}
								},
								{
									"listen": "test",
									"script": {
										"exec": [
											"// Test to check the status code\r",
											"\r",
											"pm.test(\"Check status code 201\", ()=>\r",
											"{\r",
											"    pm.response.to.have.status(201);\r",
											"})\r",
											"\r",
											"// Test to capture the response body and store it in an gloabls variable\r",
											"\r",
											"var jsonData = JSON.parse(responseBody);\r",
											"pm.globals.set(\"tokens\", jsonData.accessToken);\r",
											"\r",
											"// Test token is present in the response body\r",
											"\r",
											"pm.test(\"Check if token is present in the response body\", ()=>\r",
											"{\r",
											"    pm.expect(jsonData.accessToken).to.not.be.null;\r",
											"})"
