				{
					"name": "Existing order",
					"item": [
						{
							"name": "Get order list",
							"event": [
								{
									"listen": "test",
									"script": {
										"exec": [
											"// Test to check if the response status code is 200.\r",
											"\r",
											"pm.test(\"Check status code is 200\", ()=>\r",
											"{\r",
											"    pm.response.to.have.status(200);\r",
											"})\r",
											"\r",
											"// Test response header with content-type includes application/json\r",
											"\r",
											"var jsonData = pm.response.json();\r",
											"\r",
											"pm.test(\"Check content-type header is a application/json\" ,()=>\r",
											"{\r",
											"    pm.expect(pm.response.headers.get(\"content-type\")).to.eql(\"application/json\");\r",
											"})\r",
											"\r",
											"// Validaete all keys are present or not\r",
											"\r",
											"pm.test(\"All field exists\", ()=>\r",
											"{\r",
											"    pm.expect(jsonData).to.have.all.keys(\"id\", \"bookId\", \"customerName\", \"quantity\", \"timestamp\");\r",
											"})\r",
											"\r",
											"//  Testing cookies is present or not\r",
											"\r",
											"pm.test(\"Cookies are present\", function () {\r",
											"    let cookies = pm.cookies.toObject();\r",
											"    pm.expect(Object.keys(cookies).length).to.be.above(0);\r",
											"});\r",
											"\r",
											"\r",
											"// Check if the order_id is present in the response\r",
											"\r",
											"pm.test(\"Check if Id is present in the response\", ()=>\r",
											"{\r",
											"    pm.expect(jsonData).to.have.property(\"id\");\r",
											"});\r",
											"\r",
											"// Check response time 200-500 ms\r",
											"\r",
											"pm.test(\"Response time is less than 500ms\", function () {\r",
											"pm.expect(pm.response.responseTime).to.be.below(500);\r",
											"});\r",
											"\r",
											"// Check if field types are correct \r",
											"\r",
											"pm.test(\"Field types are correct\", function () {\r",
											"    pm.expect(jsonData.id).to.be.a(\"string\");\r",
											"    pm.expect(jsonData.bookId).to.be.a(\"number\");\r",
											"    pm.expect(jsonData.customerName).to.be.a(\"string\");\r",
											"    pm.expect(jsonData.quantity).to.be.a(\"number\");\r",
											"    pm.expect(jsonData.timestamp).to.be.a(\"number\");\r",
											"});\r",
											"\r",
											"// JSON Schema Validation using ajv vaidator\r",
											"const Ajv = require('ajv');\r",
											"const ajv = new Ajv({ allErrors: true });\r",
											"\r",
											"pm.test(\"JSON schema validation using ajv validator\", function () {\r",
											"    let jsonData = pm.response.json();\r",
											"\r",
											"    let schema = {\r",
											"        \"type\": \"object\",\r",
											"        \"properties\": {\r",
											"            \"id\": { \"type\": \"string\" },\r",
											"            \"bookId\": { \"type\": \"integer\" },\r",
											"            \"customerName\": { \"type\": \"string\" },\r",
											"            \"quantity\": { \"type\": \"integer\" },\r",
											"            \"timestamp\": { \"type\": \"integer\" }\r",
											"        },\r",
											"        \"required\": [\"id\", \"bookId\", \"customerName\", \"quantity\", \"timestamp\"]\r",
											"    };\r",
											"\r",
											"    const validate = ajv.compile(schema);\r",
											"    const valid = validate(jsonData);\r",
											"\r",
											"    if (!valid) {\r",
											"        console.log(\"Schema Errors:\", validate.errors);\r",
											"    }\r",
											"\r",
											"    pm.expect(valid, \"Schema validation failed\").to.be.true;\r",
											"});\r",
											"\r",
											"\r",
											"// Check schema validatio using tjv validator\r",
											"\r",
											"var schema = {\r",
											"  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r",
											"  \"type\": \"object\",\r",
											"  \"properties\": {\r",
											"    \"id\": {\r",
											"      \"type\": \"string\"\r",
											"    },\r",
											"    \"bookId\": {\r",
											"      \"type\": \"integer\"\r",
											"    },\r",
											"    \"customerName\": {\r",
											"      \"type\": \"string\"\r",
											"    },\r",
											"    \"quantity\": {\r",
											"      \"type\": \"integer\"\r",
											"    },\r",
											"    \"timestamp\": {\r",
											"      \"type\": \"integer\"\r",
											"    }\r",
											"  },\r",
											"  \"required\": [\r",
											"    \"id\",\r",
											"    \"bookId\",\r",
											"    \"customerName\",\r",
											"    \"quantity\",\r",
											"    \"timestamp\"\r",
											"  ]\r",
											"};\r",
											"pm.test(\"Check if response body matches the schema\", () => {\r",
											"    pm.expect(tv4.validate(jsonData, schema)).to.be.true;\r",
											"});"
										],
										"type": "text/javascript",
										"packages": {},
										"requests": {}
									}
								}
